{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach",
            "port": 9229,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "extensionHost"
        },
        {
            "name": "Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "userDataDir": "${workspaceFolder}/.vscode/.karavan-devhost",
            "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
            "outFiles": ["${workspaceFolder}/dist/extension.js"],
            "stopOnEntry": false,
            "showReturnValue": true,
            "preLaunchTask": "npm: watch"
        },
        {
            "name": "Extension (no other extensions)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "userDataDir": "${workspaceFolder}/.vscode/.karavan-devhost",
            "args": [
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "/tmp/karavan-test"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "stopOnEntry": false,
            "showReturnValue": true,
            "preLaunchTask": "npm: watch"
        },
        {
            "name": "Extension (little extensions)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "userDataDir": "${workspaceFolder}/.vscode/.karavan-devhost",
            "args": [
                
                "--extensionDevelopmentPath=${workspaceFolder}",
                "/tmp/karavan-test"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "stopOnEntry": false,
            "showReturnValue": true,
            "preLaunchTask": "npm: watch"
        },
        {
            "name": "Run Web Extension in VS Code",
            "type": "pwa-extensionHost",
            "debugWebWorkerHost": true,
            "request": "launch",
            "args": [
                
              "--extensionDevelopmentPath=${workspaceFolder}",
              "--extensionDevelopmentKind=web"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.*"],
            "preLaunchTask": "npm: watch"
          }
    ]
  }